# Copy to .env next to docker-compose.yml and fill in.

# Central registry every node pulls from, e.g. registry.zeptile.software or
# ghcr.io/zeptile. The CLI pushes builds here.
DOCKTRINE_REGISTRY=
# Only if the registry needs a login to pull
DOCKTRINE_REGISTRY_USER=
DOCKTRINE_REGISTRY_PASSWORD=

# Nginx Proxy Manager admin API, used to create proxy hosts and certificates.
# A dedicated NPM user is better than the admin account.
DOCKTRINE_NPM_URL=http://host.docker.internal:81
DOCKTRINE_NPM_EMAIL=
DOCKTRINE_NPM_PASSWORD=
DOCKTRINE_LETSENCRYPT_EMAIL=
# Optional: reuse an existing certificate (e.g. a wildcard) instead of
# requesting one per hostname. Its ID is in NPM's SSL Certificates page URL.
DOCKTRINE_NPM_CERTIFICATE_ID=

# Master key for encrypting secrets (64 hex chars: `openssl rand -hex 32`).
# If empty, Docktrine generates data/secret.key on first start. Either way,
# losing it means losing every stored secret.
DOCKTRINE_SECRET_KEY=
